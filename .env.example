# SMTP Email Configuration (WebSupport)
# CRITICAL: Never commit .env.local to git!

SMTP_HOST=smtp.m1.websupport.sk
SMTP_PORT=465
SMTP_USER=dispecing@e-taxike.sk
SMTP_PASS=your_password_here

# Optional: Site URL
NEXT_PUBLIC_SITE_URL=https://e-taxike.sk

# ─── Portál (backend) ──────────────────────────────────────────────────────────

# Databáza MySQL/MariaDB z hostingu Polar55 (cPanel → MySQL Databases).
# Formát: mysql://POUZIVATEL:HESLO@HOST:PORT/DATABAZA
DATABASE_URL=mysql://etaxi_user:heslo@localhost:3306/etaxi_portal

# Tajný kľúč na podpisovanie prihlasovacích tokenov (min. 32 náhodných znakov).
# Vygenerujte napr.: openssl rand -hex 32
AUTH_JWT_SECRET=zmente_ma_na_dlhy_nahodny_retazec

# Cloudflare Turnstile — overenie, že sa prihlasuje človek (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Prvý majiteľ (vytvorí sa pri `npm run seed`, ak ešte neexistuje)
INITIAL_OWNER_EMAIL=majitel@e-taxike.sk
INITIAL_OWNER_PASSWORD=zmente_toto_heslo
INITIAL_OWNER_MENO=Meno
INITIAL_OWNER_PRIEZVISKO=Priezvisko
